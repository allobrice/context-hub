# Copier en .env.local (ignoré par git), lu par `pnpm dev` / `pnpm start` via --env-file-if-exists.
# Toutes les variables sont facultatives : les valeurs ci-dessous sont les défauts.

# Écoute locale uniquement en dev.
CONTEXT_HUB_HOST=127.0.0.1
CONTEXT_HUB_PORT=8787
# Seule origine autorisée par CORS (le front Vite).
CONTEXT_HUB_WEB_ORIGIN=http://localhost:5173
CONTEXT_HUB_WORKSPACE_NAME=Espace AlloVoisins
# Base SQLite (relative à apps/server).
CONTEXT_HUB_DB_PATH=data/context-hub.db
