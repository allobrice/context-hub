{
  "name": "@context-hub/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/db/cli/migrate.ts",
    "db:seed": "tsx src/infrastructure/db/cli/seed.ts"
  },
  "dependencies": {
    "@context-hub/domain": "workspace:*",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
