# Copier en .env.local (ignoré par git). Toutes les variables sont facultatives.

# Source des données : memory (défaut : fixtures, ?mock=*) ou http (API apps/server via le proxy /api).
VITE_DATA_SOURCE=memory
# URL du serveur MCP affichée dans « Utiliser dans Claude Code ». Absente : placeholder [HÔTE].
VITE_MCP_URL=http://127.0.0.1:8787/mcp

# ── Côté Node uniquement (proxy Vite), JAMAIS exposé au navigateur (pas de préfixe VITE_) ──
# Jeton affiché par `pnpm --filter @context-hub/server db:seed`, injecté par le proxy /api.
CONTEXT_HUB_DEV_TOKEN=
# Cible du proxy /api (défaut : http://127.0.0.1:8787).
CONTEXT_HUB_API_TARGET=
